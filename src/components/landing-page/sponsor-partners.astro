---
import { HISTORICAL_COLLABORATIONS } from "../../data/sponsor.data";
---
<section class="section alt" id="sponsor-partners"><div class="wrap"><div class="eyebrow mono">Partners</div><h2 class="section-title">A portfolio of collaboration.</h2><div class="portfolio-grid">{HISTORICAL_COLLABORATIONS.map((brand) => <article class="portfolio-card"><div class="portfolio-logo"><img src={brand.logo} alt={brand.name} loading="lazy" decoding="async" /></div><div class="portfolio-copy"><div class="mono">Historical collaboration</div><h3>{brand.name}</h3></div></article>)}</div><a class="button primary" href="/sponsor" style="margin-top:28px">Explore partnership →</a></div></section>
