---
interface Props {
  /** Dot color; omit for a plain section label. */
  color?: string;
  /** Darker, medium-weight variant used in page heroes. */
  strong?: boolean;
  class?: string;
}

const { color, strong = false, class: className } = Astro.props;
---

<div class:list={["eyebrow", { "eyebrow--strong": strong }, className]}>{color && <span class="dot" style={`--dot: ${color}`}></span>}<slot /></div>
