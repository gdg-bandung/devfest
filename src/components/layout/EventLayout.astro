---
import BaseHead from "./BaseHead.astro";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import { SITE } from "../../data/site.data";

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.seoTitle, description = SITE.seoDescription } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <div class="page">
      <Navbar />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
