---

<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-about">
        <img src={IMAGES.logoGdgFooter} alt="Google Developer Groups Bandung" width="334" height="48" loading="lazy" decoding="async" />
        <p>We organize events ranging from small meetups to large-scale conferences like DevFest to create spaces for developers to learn, connect, and grow together. Our community welcomes developers of all levels, from beginners to experts.</p>
      </div>
      <div class="footer-cols">
        <div class="footer-col">
          <div class="footer-col-title">Community</div>
          <a href={LINKS.brandGuidelines}>Brand Guidelines</a>
          <a href={LINKS.codeOfConduct}>Code of Conduct</a>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Contact Us</div>
          <a href={LINKS.terms}>Request for Media Partner</a>
          <a href={LINKS.sponsorship}>Join as Partner</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Google Developer Group Bandung • All rights reserved.</span>
      <div class="footer-social">
        <span>Connect With Us</span>
        <div class="footer-social-icons">
          {socials.map((social) => (
            <a href={social.href} aria-label={social.name}>
              <svg aria-hidden="true" width="16" height="16" viewBox={social.viewBox} fill="none" set:html={social.icon} />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
