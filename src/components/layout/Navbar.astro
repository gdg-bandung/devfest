---
const path = Astro.url.pathname;
const links = [
  { name: "Home", href: "/" },
  { name: "Speakers", href: "/speakers", soon: true },
  { name: "Schedule", href: "/schedule", soon: true },
  { name: "Sponsor", href: "/sponsor" },
  { name: "CFP", href: "/cfp" },
  { name: "Venue", href: "/venue", soon: true },
  { name: "FAQ", href: "/faq" },
];
---

<header class="site-header">
  <nav class="wrap nav" id="nav" aria-label="Primary navigation">
    <a class="logo-brand" href="/" aria-label="DevFest Bandung 2026 home">
      <img src="/logo-devfest.webp" alt="DevFest Bandung" width="154" height="45" />
    </a>
    <ul class="navlinks" id="primary-links">
      {links.map((link) => (
        <li class="nav-item">
          {link.soon ? <span class="disabled-link" aria-disabled="true">{link.name}</span> : <a class={path === link.href ? "active" : ""} href={link.href} aria-current={path === link.href ? "page" : undefined}>{link.name}</a>}
          {link.soon && <span class="soon">Coming soon</span>}
        </li>
      ))}
      <li class="mobile-register-item"><button class="button primary mobile-register" data-open-modal type="button">Register</button></li>
    </ul>
    <button class="button primary register-button" data-open-modal type="button">Register</button>
    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="primary-links" id="nav-toggle" type="button">
      <img src="/icons/menu.svg" alt="" />
    </button>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  toggle?.addEventListener("click", () => {
    const nav = document.getElementById("nav");
    const open = nav?.classList.toggle("open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });
</script>
