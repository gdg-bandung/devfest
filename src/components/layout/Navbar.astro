---
import { IMAGES, LINKS, NAV_LINKS } from "../../data/site.data";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = (href: string) => (href === path ? "page" : undefined);
---

<header class="site-header">
  <nav class="nav" aria-label="Main">
    <a class="nav-logo" href="/"><img src={IMAGES.logoDevfest} alt="DevFest Bandung" width="151" height="44" /></a>
    <div class="nav-desktop">
      {NAV_LINKS.map((link) => <a class="navlink" href={link.href} aria-current={current(link.href)}>{link.name}</a>)}
      <a class="btn btn--blue btn--sm" href={LINKS.register}>Register</a>
    </div>
    <button type="button" class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" data-nav-toggle>
      <svg class="icon-open" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      <svg class="icon-close" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </nav>
  <div class="nav-mobile" id="mobile-nav" hidden>
    {NAV_LINKS.map((link) => <a class="mnavlink" href={link.href} aria-current={current(link.href)}>{link.name}<span aria-hidden="true">→</span></a>)}
    <a class="btn btn--blue btn--block" href={LINKS.register}>Register now →</a>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = document.getElementById("mobile-nav");

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };

  toggle?.addEventListener("click", () => setOpen(menu?.hidden ?? false));
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
</script>
