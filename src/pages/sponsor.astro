---
import EventLayout from "../components/layout/EventLayout.astro";
---

<EventLayout title="Sponsor — DevFest 2026 Bandung"
  ><section class="page-hero">
    <div class="wrap">
      <div class="eyebrow mono">Sponsorship</div><h1>
        Meet the builders<br /><span class="gradient">behind the future.</span>
      </h1><p>
        Partner with one of Indonesia’s most engaged developer communities
        through a sponsorship designed around real outcomes.
      </p><a
        class="button primary"
        style="margin-top:22px"
        href="mailto:gdgbandung@gmail.com?subject=DevFest%202026%20Sponsorship"
        >Request sponsorship deck →</a>
    </div>
  </section><section class="section alt">
    <div class="wrap two-col">
      <div>
        <div class="eyebrow mono">A thoughtful partnership</div><h2
          class="section-title"
        >
          More than a logo on a screen.
        </h2><p class="section-copy">
          Like the most effective community events, we build sponsor packages
          around your goals—talent, product conversations, credibility, and
          durable relationships with developers.
        </p>
      </div><div class="card">
        <div class="mono" style="color:#34a853">Open for partners</div><h3>
          International brands, local relevance
        </h3><p>
          Our team will work with you to create a presence that feels useful and
          authentic to the community.
        </p>
      </div>
    </div><div class="tiers">
      <article class="tier">
        <div class="mono">Connect</div><h3>Community partner</h3><ul>
          <li>Brand visibility</li><li>Community touchpoints</li><li>
            Social amplification
          </li>
        </ul>
      </article><article class="tier featured">
        <div class="mono" style="color:#4285f4">Collaborate</div><h3>
          Experience partner
        </h3><ul>
          <li>On-site activation</li><li>Recruiting & product moments</li><li>
            Curated audience engagement
          </li>
        </ul>
      </article><article class="tier">
        <div class="mono">Lead</div><h3>Title partner</h3><ul>
          <li>Category ownership</li><li>Custom partnership design</li><li>
            Leadership visibility
          </li>
        </ul>
      </article>
    </div>
  </section></EventLayout
>
