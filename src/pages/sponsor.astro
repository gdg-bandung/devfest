---
import EventLayout from "../components/layout/EventLayout.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import { IMAGES, LINKS, SITE } from "../data/site.data";

const stats = [
  { value: "64.94%", label: "professionals", color: "var(--stat-blue)" },
  { value: "392", label: "female registrants", color: "var(--stat-pink)" },
  { value: "27", label: "speakers & panelists", color: "var(--sunny)" },
  { value: "13", label: "partners & sponsors", color: "var(--stat-green)" },
  { value: "2,100+", label: "YouTube live stream viewers", color: "var(--stat-blue)" },
  { value: "71", label: "media coverage", color: "var(--sunny)" },
];

const gallery = [
  { src: IMAGES.heroGroup, alt: "Full auditorium group photo at DevFest Bandung 2025" },
  { src: IMAGES.organisersMascot, alt: "Organisers posing with the DevFest mascot" },
  { src: IMAGES.keynoteStage, alt: "Keynote speaker on the main stage in front of the audience" },
  { src: IMAGES.industryTalk, alt: "Panel discussion with industry speakers" },
  { src: IMAGES.dancePerformance, alt: "Traditional dance performance on stage" },
  { src: IMAGES.audienceQuestion, alt: "Audience asking a question during a session" },
];

const reasons = [
  { number: "01", tone: "bg-blue-soft", title: "Reach the right people", copy: "A curated audience of professional developers and builders working on AI, cloud and product." },
  { number: "02", tone: "bg-red-soft", title: "Make your product useful", copy: "Show real use cases through a workshop, a challenge or a booth people actually want to visit." },
  { number: "03", tone: "bg-green-soft", title: "Build lasting trust", copy: "Support the local GDG ecosystem that meets, learns and builds in Bandung all year round." },
];

const spaces = [
  {
    image: IMAGES.handsOnCodelab,
    alt: "Participants in a hands-on codelab",
    title: "Hands-on codelab & workshop",
    copy: "Participants try the newest Google tools from this year’s Google I/O.",
    partners: "showcase your tools through real use cases and position your solution directly to a high-intent audience.",
  },
  {
    image: IMAGES.networking,
    alt: "Attendees chatting during a networking break",
    title: "Networking & collaboration area",
    copy: "A space to connect, swap ideas and find collaborators.",
    partners: "meet participants at your booth or on the open floor during breaks to generate leads and grow brand awareness.",
  },
  {
    image: IMAGES.industryTalk,
    alt: "Expert panel on stage",
    title: "Industry talks & expert sessions",
    copy: "Panels and deep dives on AI trends and real-world applications.",
    partners: "join as a speaker, share your expertise and strengthen your credibility with a targeted tech audience.",
  },
];
---

<EventLayout title="Sponsor — DevFest Bandung 2026">
  <!-- HERO -->
  <section class="section gridbg">
    <div class="container hero">
      <div class="stack" style="flex: 1 1 640px; --gap: 24px">
        <Eyebrow>Sponsorship 2026</Eyebrow>
        <h1 class="display">Put your brand<br />to work.</h1>
        <p class="lead" style="max-width: 640px">Partner with GDG Bandung to reach professional developers and builders on 19 December 2026 at El Hotel Bandung.</p>
        <div class="cluster" style="padding-top: 8px">
          <a class="btn btn--blue btn--lg" href={LINKS.sponsorship}>Become a sponsor →</a>
        </div>
      </div>
      <div class="box card glance">
        <div class="label">AT A GLANCE</div>
        <div class="glance-row"><span class="dot dot--sm"></span><span><strong>{SITE.dateShort}</strong><br />{SITE.time}</span></div>
        <div class="glance-row"><span class="dot dot--sm" style="--dot: var(--red)"></span><span><strong>{SITE.venue}</strong><br /><a href={LINKS.maps}>Open in Google Maps ↗</a></span></div>
      </div>
    </div>
  </section>

  <!-- 2025 HIGHLIGHTS -->
  <section class="section section--dark">
    <div class="container stack" style="--gap: 48px">
      <div class="stack">
        <Eyebrow color="var(--yellow)">DevFest Bandung 2025 · Last year’s highlights</Eyebrow>
        <h2 class="title">Quality audience, real engagement, results that mattered to sponsors.</h2>
      </div>

      <div class="cluster" style="--gap: 32px">
        <div class="grid-2 stats">
          <div class="span-all stat-hero">
            <div class="stat-hero-value">2,000+</div>
            <div class="stat-hero-label">participants</div>
          </div>
          {stats.map((stat) => (
            <div class="stat">
              <div class="stat-value" style={`color: ${stat.color}`}>{stat.value}</div>
              <div class="stat-label">{stat.label}</div>
            </div>
          ))}
        </div>
        <div class="grid-2 gallery">
          {gallery.map((photo) => <img class="photo" src={photo.src} alt={photo.alt} loading="lazy" />)}
        </div>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="section">
    <div class="container stack" style="--gap: 48px">
      <div class="head">
        <Eyebrow color="var(--red)">Why partner</Eyebrow>
        <h2 class="title">Be useful, not just visible.</h2>
      </div>
      <div class="auto-grid" style="--min: 280px">
        {reasons.map((reason) => (
          <div class:list={["reason", "card", reason.tone]}>
            <div class="mono reason-number">{reason.number}</div>
            <h3>{reason.title}</h3>
            <p>{reason.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PARTNER SPACES -->
  <section class="section section--white">
    <div class="container stack" style="--gap: 48px">
      <div class="head">
        <Eyebrow color="var(--green)">Partner spaces</Eyebrow>
        <h2 class="title">Where your brand shows up on the day.</h2>
      </div>
      <div class="auto-grid" style="--min: 300px; --gap: 28px">
        {spaces.map((space) => (
          <article class="space card">
            <img class="photo" src={space.image} alt={space.alt} loading="lazy" />
            <div class="space-body">
              <h3>{space.title}</h3>
              <p class="space-copy">{space.copy}</p>
              <div class="space-partners"><strong>For partners:</strong> {space.partners}</div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--blue">
    <div class="container cta">
      <h2 class="title title--56">Let’s build something useful for the room.</h2>
      <div class="cluster">
        <a class="btn btn--dark" href={LINKS.sponsorship}>Become a sponsor →</a>
      </div>
    </div>
  </section>
</EventLayout>

<style>
  .hero { padding: 80px 32px 88px; display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-end; justify-content: space-between; }
  .glance { flex: 0 1 340px; padding: 28px; display: flex; flex-direction: column; gap: 16px; }
  .glance-row { display: flex; gap: 12px; align-items: baseline; }

  .stats { flex: 1 1 460px; align-content: start; }
  .stat-hero { background: var(--blue); color: var(--ink); border: 1px solid var(--line-dark); padding: 28px 32px; }
  .stat-hero-value { font-size: clamp(64px, 7vw, 96px); font-weight: 700; line-height: 0.95; letter-spacing: -0.03em; }
  .stat-hero-label { font-size: 20px; padding-top: 8px; font-weight: 700; }
  .stat { border: 1px solid var(--line-dark); padding: 22px 24px; }
  .stat-value { font-size: 40px; font-weight: 700; line-height: 1; }
  .stat-label { font-size: 16px; padding-top: 8px; }
  .gallery { flex: 1 1 560px; }
  .gallery img { height: 200px; border: 1px solid var(--line-dark); }

  .reason { padding: 32px; display: flex; flex-direction: column; gap: 12px; }
  .reason-number { font-size: 14px; font-weight: 700; }
  .reason h3 { margin: 0; font-size: 26px; font-weight: 700; }
  .reason p { margin: 0; font-size: 17px; line-height: 1.6; }

  .space { background: var(--paper); display: flex; flex-direction: column; }
  .space img { height: 200px; border-bottom: 1px solid var(--line); }
  .space-body { padding: 28px; display: flex; flex-direction: column; gap: 12px; }
  .space h3 { margin: 0; font-size: 22px; font-weight: 700; }
  .space-copy { margin: 0; font-size: 16px; line-height: 1.6; color: var(--muted); }
  .space-partners { border-top: 1px solid var(--line); padding-top: 12px; font-size: 16px; line-height: 1.6; }

  .cta { padding: 80px 32px; display: flex; flex-wrap: wrap; gap: 32px; align-items: center; justify-content: space-between; }
  .cta .title { flex: 1 1 560px; color: var(--ink); }

  @media (max-width: 600px) {
    .stat-value { font-size: 30px; }
  }
</style>
