---
import EventLayout from "../components/layout/EventLayout.astro";
---

<EventLayout title="Schedule — DevFest 2026 Bandung"
  ><section class="page-hero">
    <div class="wrap">
      <div class="eyebrow mono">Programme</div><h1>
        A day worth<br /><span class="gradient"
          >clearing your calendar for.</span>
      </h1><p>
        The 2026 schedule will be published after speaker selection. Look
        forward to talks, workshops, panels, podcasts and community moments.
      </p><div class="notice">
        Schedule coming soon. Join the waiting list for the first release.
      </div><button
        class="button primary"
        data-open-modal
        style="margin-top:22px">Get programme updates →</button>
    </div>
  </section></EventLayout
>
