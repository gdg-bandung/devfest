---
import EventLayout from "../components/layout/EventLayout.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import FaqItem from "../components/ui/FaqItem.astro";
import { HOME_FAQS, LINKS, PHOTOS, SITE, srcset } from "../data/site.data";


const themeWords = [
  { word: "BUILD", color: "var(--blue)" },
  { word: "SECURE", color: "var(--red)" },
  { word: "SCALE", color: "var(--green)" },
  { word: "AGENTIC ERA", color: "var(--yellow)" },
];

const tracks = [
  {
    number: "Track 01",
    audience: "For anyone who wants to build",
    title: "Builder track",
    tone: "bg-blue-soft",
    description:
      "Start with a problem, then turn it into a useful app, workflow or prototype with AI assistance. Designed for developers and builders across product, design, marketing and beyond.",
    points: ["AI-assisted apps and prototypes", "Automating and optimising workflows", "Picking the right Google tools for the job"],
  },
  {
    number: "Track 02",
    audience: "For professional devs & eng teams",
    title: "Developer track",
    tone: "bg-red-soft",
    description:
      "Go deeper into the agent ecosystem: develop, deploy, govern, secure and scale autonomous systems for production environments.",
    points: ["Building and orchestrating agents", "Governance and secure-by-default systems", "Taking multi-agent apps to production scale"],
  },
];

const activities = [
  {
    image: PHOTOS.handsOnCodelab,
    alt: "A mentor helping participants on their laptops during a codelab",
    color: "var(--blue)",
    title: "Hands-on codelab & workshop",
    copy: "Try the newest Google tools and updates from this year’s Google I/O — Gemini, Android, Firebase, Google Cloud — with mentors in the room.",
  },
  {
    image: PHOTOS.networking,
    alt: "Attendees gathered around phones, chatting during a networking break",
    color: "var(--red)",
    title: "Networking & collaboration area",
    copy: "Meet other participants, swap ideas and find collaborators among developers, experts and communities.",
  },
  {
    image: PHOTOS.industryTalk,
    alt: "Industry experts on a panel at DevFest Bandung 2025",
    color: "var(--yellow)",
    title: "Industry talks & expert sessions",
    copy: "Panel discussions and deep dives with industry experts on AI trends and real-world applications.",
  },
];

const topics = ["Gemini", "Chrome", "Flutter", "Android", "Google Cloud", "Firebase", "Antigravity", "Gemma", "Gemini Code Assist", "Figma", "Google Labs"];

const lastYear = [
  { value: "2,000+", label: "participants", color: "var(--stat-blue)" },
  { value: "64.94%", label: "professionals", color: "var(--stat-green)" },
  { value: "27", label: "speakers & panelists", color: "var(--sunny)" },
  { value: "2,100+", label: "YouTube live viewers", color: "var(--stat-pink)" },
];
---

<EventLayout>
  <!-- HERO -->
  <section class="section gridbg">
    <div class="container hero">
      <div class="hero-copy">
        <Eyebrow>Google Developer Group Bandung presents</Eyebrow>
        <h1 class="display display--xl">DevFest<br />Bandung 2026</h1>
        <p class="hero-tagline"><strong>Build, secure, scale:</strong> developers and builders in the agentic era.</p>
        <div class="cluster" style="--gap: 12px">
          <div class="hero-fact"><span class="dot dot--sm"></span><span><strong>{SITE.dateMedium}</strong> · {SITE.time}</span></div>
          <a class="hero-fact" href={LINKS.maps}><span class="dot dot--sm" style="--dot: var(--red)"></span><span><strong>{SITE.venue}</strong> ↗</span></a>
          <div class="hero-fact"><span class="dot dot--sm" style="--dot: var(--yellow)"></span><span><strong>Only 500 seats</strong> · limited quota</span></div>
        </div>
        <div class="cluster hero-actions">
          <a class="btn btn--blue btn--lg" href={LINKS.register}>Register now →</a>
          <a class="btn" href={LINKS.cfs}>Submit a talk</a>
          <a class="btn" href={LINKS.sponsorship}>Become a sponsor</a>
        </div>
      </div>

      <div class="collage">
        <figure class="collage-main card">
          <img class="photo" src={PHOTOS.heroGroup.src} srcset={srcset(PHOTOS.heroGroup)} sizes="(max-width: 1100px) calc(100vw - 52px), 580px" width={PHOTOS.heroGroup.width} height={PHOTOS.heroGroup.height} alt="Full auditorium of DevFest Bandung 2025 attendees posing for a group photo" fetchpriority="high" />
          <figcaption class="mono tag tag--outline" style="background: var(--blue)">DEVFEST BANDUNG 2025</figcaption>
        </figure>
        <figure class="card">
          <img class="photo" src={PHOTOS.industryTalk.src} srcset={srcset(PHOTOS.industryTalk)} sizes="(max-width: 1100px) calc(50vw - 36px), 290px" width={PHOTOS.industryTalk.width} height={PHOTOS.industryTalk.height} alt="Panel discussion on stage" />
          <figcaption class="mono tag tag--sm tag--pill" style="background: var(--red); color: var(--on-red)">EXPERT PANELS</figcaption>
        </figure>
        <figure class="card">
          <img class="photo" src={PHOTOS.handsOnCodelab.src} srcset={srcset(PHOTOS.handsOnCodelab)} sizes="(max-width: 1100px) calc(50vw - 36px), 290px" width={PHOTOS.handsOnCodelab.width} height={PHOTOS.handsOnCodelab.height} alt="Attendees working on laptops during a codelab" />
          <figcaption class="mono tag tag--sm tag--outline" style="background: var(--green)">HANDS-ON CODELABS</figcaption>
        </figure>
        <div class="sticker">
          <div class="sticker-value">500</div>
          <div class="sticker-label">seats only<br />· limited ·</div>
        </div>
      </div>
    </div>
  </section>

  <!-- THEME MARQUEE -->
  <div class="marquee">
    <div class="marquee-inner">
      {themeWords.map((item) => <span class="marquee-word"><span class="dot dot--lg" style={`--dot: ${item.color}`}></span>{item.word}</span>)}
    </div>
  </div>

  <!-- THEME -->
  <section id="theme" class="section">
    <div class="container stack" style="--gap: 48px">
      <div class="theme-intro">
        <div class="stack" style="flex: 1 1 480px">
          <Eyebrow color="var(--red)">Our 2026 theme</Eyebrow>
          <h2 class="title">“Build, secure, scale: Developers and builders in the agentic era”</h2>
        </div>
        <p class="copy" style="flex: 1 1 380px">The developer’s job is shifting from writing code to reviewing it and orchestrating autonomous agents. Models and tools keep getting stronger, so you can do more, faster.</p>
      </div>

      <div class="auto-grid" style="--min: 320px">
        <div class="box card theme-card">
          <div class="theme-card-title">AI opens the door for everyone</div>
          <p class="copy-17">More people can now solve more problems, and bring more diverse ideas to life than ever before. “Builders” use their skills and AI assistance to build apps, automate and optimise workflows, and create solutions for any industry — from product management to design.</p>
        </div>
        <div class="box card theme-card">
          <div class="theme-card-title">Secure by default, scaled with intent</div>
          <p class="copy-17">Gartner predicts that 80% of technology products and services will soon be built by people who are not professional software developers. In that world, a secure-by-default mindset matters more than ever — and so does choosing the right models, platforms and tools for your goals.</p>
        </div>
      </div>

      <div class="box auto-grid info-strip" style="--min: 240px; --gap: 0">
        <div class="info-cell" style="border-right: 1px solid var(--line); border-top-color: var(--blue)">
          <div class="label" style="text-transform: uppercase">Date &amp; time</div>
          <div class="info-value">{SITE.dateLong}</div>
          <div class="info-sub">{SITE.time}</div>
        </div>
        <div class="info-cell" style="border-top-color: var(--red)">
          <div class="label" style="text-transform: uppercase">Venue</div>
          <div class="info-value">{SITE.venue}</div>
          <a class="info-sub" href={LINKS.maps}>Open in Google Maps ↗</a>
        </div>
      </div>
    </div>
  </section>

  <!-- TRACKS -->
  <section id="tracks" class="section section--white">
    <div class="container stack" style="--gap: 48px">
      <div class="head">
        <Eyebrow>Learn by doing</Eyebrow>
        <h2 class="title">Two tracks. Pick the one that fits how you build.</h2>
        <p class="copy">Build an idea, secure the system, scale the outcome. Both tracks follow the same arc, at different depths.</p>
      </div>
      <div class="auto-grid" style="--min: 340px; --gap: 32px">
        {tracks.map((track) => (
          <article class:list={["track", "card", track.tone]}>
            <div class="track-top">
              <span class="mono track-number">{track.number}</span>
              <span class="mono track-audience">{track.audience}</span>
            </div>
            <h3 class="track-title">{track.title}</h3>
            <p class="track-copy">{track.description}</p>
            <ul class="arrow-list">
              {track.points.map((point) => <li><span aria-hidden="true">→</span>{point}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- KEY ACTIVITIES -->
  <section id="activities" class="section">
    <div class="container stack" style="--gap: 48px">
      <div class="head">
        <Eyebrow color="var(--green)">Key activities</Eyebrow>
        <h2 class="title">One day to learn, meet and build.</h2>
      </div>
      <div class="auto-grid" style="--min: 300px; --gap: 28px">
        {activities.map((activity) => (
          <article class="box card activity">
            <img class="photo" src={activity.image.src} srcset={srcset(activity.image)} sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1100px) 50vw, 400px" width={activity.image.width} height={activity.image.height} alt={activity.alt} loading="lazy" decoding="async" />
            <div class="activity-body">
              <div class="activity-bar" style={`background: ${activity.color}`}></div>
              <h3>{activity.title}</h3>
              <p class="copy-17">{activity.copy}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="topics">
        <span class="eyebrow">Topics</span>
        <div class="cluster" style="--gap: 10px">
          {topics.map((topic) => <span class="chip">{topic}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- LAST YEAR -->
  <section class="section section--dark">
    <div class="container last-year">
      <div class="stack" style="flex: 1 1 420px">
        <Eyebrow color="var(--yellow)">DevFest Bandung 2025</Eyebrow>
        <h2 class="title title--56">Last year, the room was full.</h2>
        <p class="copy" style="color: var(--on-dark)">A quality audience, real engagement, and results that mattered to sponsors.</p>
        <a class="recap-link" href="/sponsor">See the full 2025 recap →</a>
      </div>
      <div class="grid-2" style="flex: 1 1 520px">
        {lastYear.map((stat) => (
          <div class="stat">
            <div class="stat-value" style={`color: ${stat.color}`}>{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PARTNERS -->
  <section id="partners" class="section">
    <div class="container partners">
      <div class="stack" style="flex: 1 1 440px">
        <Eyebrow>Partner with the community</Eyebrow>
        <h2 class="title">Make your brand useful in the room.</h2>
        <p class="copy">DevFest partnerships work best when they help people learn, try, meet or build. Bring a product, a challenge, a hiring story or a community commitment to a high-intent audience of developers and builders.</p>
        <div class="cluster" style="padding-top: 8px">
          <a class="btn btn--blue" href={LINKS.sponsorship}>Become a sponsor →</a>
        </div>
      </div>
      <div class="grid-2" style="flex: 1 1 520px; --gap: 20px">
        {[1, 2, 3].map(() => (
          <div class="box card">
            <div class="logo-slot"><span class="mono">[ SPONSOR LOGO ]</span></div>
            <div class="logo-meta"><span class="label" style="font-size: 11px">2026 PARTNER</span><span>[Partner name]</span></div>
          </div>
        ))}
        <a class="your-brand" href={LINKS.sponsorship}>
          <span class="your-brand-plus">+</span>
          <span class="your-brand-title">Your brand here</span>
          <span class="your-brand-sub">Sponsorship is open</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CFS -->
  <section class="section section--green">
    <div class="container cfs-band">
      <div class="stack" style="flex: 1 1 560px; --gap: 16px">
        <Eyebrow color="var(--green)" class="eyebrow--ring">Call for speakers</Eyebrow>
        <h2 class="title title--56">Speak to the whole room.</h2>
        <p class="copy" style="color: var(--ink)">Share a practical story, a hard-won technical lesson, or a clear idea that helps people build in the agentic era. First-time speakers welcome.</p>
      </div>
      <div class="cluster">
        <a class="btn btn--dark" href={LINKS.cfs}>Submit a proposal →</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section">
    <div class="container faq-band">
      <div class="stack" style="flex: 1 1 340px">
        <Eyebrow color="var(--yellow)">Plan your day</Eyebrow>
        <h2 class="title title--56">Questions, answered.</h2>
        <a class="faq-more" href="/faq">Read all FAQs →</a>
      </div>
      <div class="stack" style="flex: 2 1 560px; --gap: 12px">
        {HOME_FAQS.map((faq, index) => <FaqItem faq={faq} open={index === 0} compact />)}
      </div>
    </div>
  </section>
</EventLayout>


<style>
  /* Hero */
  .hero { padding: 72px 32px 88px; display: flex; flex-wrap: wrap; gap: 56px; align-items: center; }
  .hero-copy { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 28px; }
  .hero-tagline { margin: 0; font-size: clamp(22px, 2.2vw, 30px); line-height: 1.3; max-width: 600px; }
  .hero-fact { display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--line); padding: 10px 16px; text-decoration: none; }
  .hero-actions { padding-top: 8px; }


  .collage { flex: 1 1 460px; min-width: 0; position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; padding: 0 12px 12px 0; }
  .collage figure { margin: 0; position: relative; background: #fff; }
  .collage figure img { height: 190px; }
  .collage .collage-main { grid-column: 1 / -1; }
  .collage .collage-main img { height: 300px; }
  .tag { position: absolute; left: 16px; bottom: 16px; color: var(--ink); padding: 6px 10px; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; }
  .tag--sm { left: 12px; bottom: 12px; padding: 4px 8px; font-size: 11px; }
  .tag--outline { border: 1px solid var(--line); }
  .tag--pill { padding: 4px 10px; border-radius: 999px; }
  .sticker { position: absolute; top: -28px; right: -8px; width: 132px; height: 132px; border-radius: 50%; background: var(--sunny); border: 1px solid var(--line); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; transform: rotate(8deg); box-shadow: var(--shadow-pop); }
  .sticker-value { font-size: 40px; font-weight: 700; line-height: 1; }
  .sticker-label { font-size: 13px; line-height: 1.2; padding-top: 4px; }

  /* Marquee */
  .marquee { background: var(--ink); color: #fff; border-bottom: 1px solid var(--line); overflow: hidden; }
  .marquee-inner { max-width: 1280px; margin: 0 auto; padding: 22px 32px; box-sizing: border-box; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px; font-weight: 700; font-size: clamp(24px, 3vw, 40px); letter-spacing: -0.02em; }
  .marquee-word { display: inline-flex; align-items: center; gap: 14px; }

  /* Theme */
  .theme-intro { display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: flex-end; }
  .theme-card { padding: 32px; display: flex; flex-direction: column; gap: 14px; }
  .theme-card-title { font-weight: 700; font-size: 22px; }
  .info-cell { padding: 24px 28px; border-top: 4px solid; display: flex; flex-direction: column; gap: 8px; }
  .info-value { font-size: 22px; font-weight: 700; line-height: 1.2; }
  .info-sub { font-size: 16px; }
  div.info-sub { color: var(--muted); }

  /* Tracks */
  .track { padding: 40px; display: flex; flex-direction: column; gap: 20px; }
  .track-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .track-number { font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .track-audience { font-size: 12px; font-weight: 700; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px; }
  .track-title { margin: 0; font-size: 44px; line-height: 1; letter-spacing: -0.03em; font-weight: 700; }
  .track-copy { margin: 0; font-size: 18px; line-height: 1.6; }

  /* Activities */
  .activity { display: flex; flex-direction: column; }
  .activity img { height: 220px; border-bottom: 1px solid var(--line); }
  .activity-body { padding: 28px; display: flex; flex-direction: column; gap: 12px; }
  .activity-bar { height: 6px; width: 48px; }
  .activity h3 { margin: 0; font-size: 24px; font-weight: 700; }
  .topics { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; padding-top: 8px; }

  /* Last year */
  .last-year { padding: 88px 32px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .recap-link { color: var(--stat-blue); font-size: 17px; font-weight: 700; }
  .stat { border: 1px solid var(--line-dark); padding: 24px; }
  .stat-value { font-size: 48px; font-weight: 700; line-height: 1; }
  .stat-label { font-size: 16px; padding-top: 8px; }

  /* Partners */
  .partners { display: flex; flex-wrap: wrap; gap: 56px; align-items: center; }
  .logo-slot { height: 130px; display: flex; align-items: center; justify-content: center; border-bottom: 1.5px dashed rgba(30, 30, 30, 0.2); background: var(--paper); }
  .logo-slot span { font-size: 14px; color: var(--muted); }
  .logo-meta { padding: 18px 20px; display: flex; flex-direction: column; gap: 6px; font-size: 18px; }
  .your-brand { background: var(--yellow-soft); border: 1.5px dashed rgba(30, 30, 30, 0.32); border-radius: 16px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-decoration: none; padding: 24px; text-align: center; min-height: 200px; }
  .your-brand-plus { font-size: 40px; font-weight: 700; line-height: 1; }
  .your-brand-title { font-size: 18px; font-weight: 700; }
  .your-brand-sub { font-size: 15px; }

  /* CFS band */
  .cfs-band { padding: 80px 32px; display: flex; flex-wrap: wrap; gap: 32px 56px; align-items: center; justify-content: space-between; }
  .cfs-band :global(.eyebrow--ring .dot) { border: 1px solid var(--line); }

  /* FAQ */
  .faq-band { display: flex; flex-wrap: wrap; gap: 48px; }
  .faq-more { font-size: 17px; font-weight: 700; }

  @media (max-width: 600px) {
    .track-top { flex-wrap: wrap; }
    .track-title { font-size: 36px; }
    .stat-value { font-size: 32px; }
    .your-brand-plus { font-size: 30px; }
  }
</style>
