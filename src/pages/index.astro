---
import EventLayout from "../components/layout/EventLayout.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import FaqItem from "../components/ui/FaqItem.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Countdown from "../components/ui/Countdown.astro";
import { HOME_FAQS, LINKS, PHOTOS, ROOMS, SITE, srcset } from "../data/site.data";

const reasons = [
  { shape: "square", title: "Build with purpose", copy: "Learn new technologies and practices through keynotes, codelabs, and technical sessions relevant to your journey." },
  { shape: "circle", title: "Grow with others", copy: "Meet fellow builders, share real concerns, and find new discussion partners or collaborators." },
  { shape: "triangle", title: "Leave with momentum", copy: "Leave with buildable ideas, actionable connections, and clear next steps within the community." },
];

const pillars = [
  { number: "01", pill: "Main Stage", pillStyle: "", title: "Big ideas for a changing industry.", copy: "Keynotes and panel sessions to explore industry trends, the future of AI, and global stories that guide direction." },
  { number: "02", pill: "The Builders Rooms", pillStyle: "--pill-bg: var(--blue)", href: "#rooms", title: "Choose your path. Build with depth.", copy: "Three parallel rooms: App Builders, Platform Builders, and Business Builders." },
  { number: "03", pill: "The Human Activity", pillStyle: "--pill-bg: var(--amber-chip); --pill-ink: var(--amber-ink)", href: "#human", title: "A space to pause, reflect, and connect.", copy: "Interactive activations for career reflection, light mindfulness, and conversations that reassure attendees they are not alone." },
  { number: "04", pill: "Vibe Hackathon", pillStyle: "--pill-bg: var(--red)", href: "#hackathon", title: "Meet strangers. Make something together.", copy: "Problem-solving sprint in small teams to create solution concepts, architectures, or wireframes — and kickstart new connections." },
];

const hackathon = [
  { label: "Format", value: "1-hour idea and problem-solving sprint" },
  { label: "Team", value: "Teams formed randomly on the day" },
  { label: "Output", value: "Solution concept, simple architecture, wireframe, or pitch" },
  { label: "Ice breaker", value: "Nametag color matching and prompt cards" },
  { label: "Finale", value: "Brief showcase for the most creative, most human, or most feasible ideas" },
];

const lastYear = [
  { value: "2,000+", label: "participants in 2025", color: "var(--blue)" },
  { value: "64.94%", label: "professionals", color: "var(--red)" },
  { value: "27", label: "speakers & panelists", color: "var(--green)" },
  { value: "2,100+", label: "YouTube live viewers", color: "var(--ink)" },
];

const speakerFormats = [
  { title: "Builders Room Session", copy: "Codelab, workshop, or case study for App, Platform, or Business Builders." },
  { title: "Main Stage Talk / Panel", copy: "Industry trends, global inspiration, implementation stories, or cross-role conversations." },
  { title: "Human Activity Facilitator", copy: "Guide reflection, community conversations, or light mindfulness safely and inclusively." },
];
---

<EventLayout>
  <!-- HERO -->
  <section class="section gridbg">
    <div class="container hero">
      <div class="hero-copy">
        <Eyebrow color="var(--g-blue)" strong>Google Developer Group Bandung presents</Eyebrow>
        <h1 class="hero-title">DevFest Bandung 2026</h1>
        <p class="hero-theme"><span style="color: var(--blue)">Tech</span> <span class="hero-theme-meets">meets</span> <span style="color: #d93025">Human</span></p>
        <p class="lead" style="max-width: 620px">One day to build, learn, breathe, and connect. DevFest Bandung 2026 brings together {SITE.capacity} developers, students, founders, and tech enthusiasts to discuss future technologies, while leaving room for stories, collaboration, and real career journeys.</p>
        <div class="cluster" style="--gap: 10px">
          <div class="fact"><span class="dot dot--sm"></span><span><strong>{SITE.dateMedium}</strong> · {SITE.time}</span></div>
          <a class="fact" href={LINKS.maps}><span class="dot dot--sm" style="--dot: var(--g-red)"></span>{SITE.venue} ↗</a>
          <div class="fact"><span class="dot dot--sm" style="--dot: var(--g-green)"></span><span><strong>{SITE.capacity} builders</strong> · 2026 capacity</span></div>
        </div>
        <div class="cluster hero-actions">
          <a class="btn btn--blue btn--lg" href={LINKS.register}>Register now →</a>
          <a class="btn btn--ghost btn--lg" href="/cfs">Submit a talk</a>
          <a class="btn btn--ghost btn--lg" href="/sponsor">Become a sponsor</a>
        </div>
      </div>

      <div class="hero-photos">
        <img class="photo hero-photo-main" src={PHOTOS.gdgSignGroup.src} srcset={srcset(PHOTOS.gdgSignGroup)} sizes="(max-width: 1100px) calc(100vw - 48px), 860px" width={PHOTOS.gdgSignGroup.width} height={PHOTOS.gdgSignGroup.height} alt="DevFest Bandung attendees posing together behind the GDG sign" fetchpriority="high" />
        <img class="photo hero-photo-sub" style="--accent: var(--g-blue)" src={PHOTOS.handsRaised.src} srcset={srcset(PHOTOS.handsRaised)} sizes="(max-width: 1100px) calc(50vw - 30px), 300px" width={PHOTOS.handsRaised.width} height={PHOTOS.handsRaised.height} alt="Attendees raising their hands and smiling during a session" />
        <img class="photo hero-photo-sub" style="--accent: var(--g-red)" src={PHOTOS.hackathonLaptopTeam.src} srcset={srcset(PHOTOS.hackathonLaptopTeam)} sizes="(max-width: 1100px) calc(50vw - 30px), 300px" width={PHOTOS.hackathonLaptopTeam.width} height={PHOTOS.hackathonLaptopTeam.height} alt="A team gathered around a laptop during the hackathon" />
      </div>
    </div>
  </section>

  <Countdown />

  <!-- WHY TECH MEETS HUMAN -->
  <section class="section section--white">
    <div class="container stack" style="--gap: 48px">
      <div class="split">
        <div class="head" style="flex: 1 1 480px">
          <Eyebrow>Why Tech Meets Human</Eyebrow>
          <h2 class="title">Technology moves fast. People need room to grow.</h2>
        </div>
        <p class="copy" style="flex: 1 1 420px">DevFest Bandung 2026 is not just about tools and trends. We designed a day that connects hard skills with the human reality behind them: learning new things, facing career shifts, overcoming feeling alone in the industry, and finding people to grow with.</p>
      </div>
      <div class="auto-grid" style="--min: 260px">
        {reasons.map((reason) => (
          <div class="tile tile--paper reason">
            <span class:list={["shape", `shape--${reason.shape}`]} aria-hidden="true"></span>
            <h3>{reason.title}</h3>
            <p class="copy-17">{reason.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FOUR PILLARS -->
  <section class="section gridbg">
    <div class="container stack" style="--gap: 48px">
      <div class="head">
        <Eyebrow>One day, four ways to grow</Eyebrow>
        <h2 class="title">Learn the tech. Meet the human. Build what is next.</h2>
        <p class="copy">Every part of DevFest is designed to provide a distinct energy: shared inspiration, focused learning, breathing space, and relaxed yet meaningful collaboration.</p>
      </div>
      <div class="auto-grid" style="--min: 270px">
        {pillars.map((pillar) => {
          const Tag = pillar.href ? "a" : "div";
          return (
            <Tag class="tile tile--white pillar" href={pillar.href}>
              <div class="pillar-top"><span class="mono pillar-number">{pillar.number}</span><span class="pill" style={pillar.pillStyle}>{pillar.pill}</span></div>
              <h3>{pillar.title}</h3>
              <p class="copy-16">{pillar.copy}</p>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <!-- BUILDERS ROOMS -->
  <section id="rooms" class="section section--white">
    <div class="container stack" style="--gap: 48px">
      <div class="head">
        <Eyebrow>Pick a room. Go deeper.</Eyebrow>
        <h2 class="title">Three learning paths for every kind of builder.</h2>
      </div>
      <div class="auto-grid" style="--min: 300px">
        {ROOMS.map((room) => (
          <article class:list={["room", `room--${room.key}`]}>
            <div class="room-head"><h3>{room.name}</h3><span class="mono room-label">{room.label}</span></div>
            <div class="room-body">
              <p class="room-audience">{room.audience}</p>
              <div class="room-field"><span class="mono room-field-label">Primary format</span><span class="room-format">{room.format}</span></div>
              <div class="room-field" style="gap: 8px">
                <span class="mono room-field-label">Example focus</span>
                <div class="cluster" style="--gap: 8px">
                  {room.topics.map((topic) => <span class="chip" style="--chip-line: var(--room-line)">{topic}</span>)}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- HUMAN ACTIVITY -->
  <section id="human" class="section human">
    <div class="container human-inner">
      <div class="stack" style="flex: 1 1 460px; min-width: 0; --gap: 20px">
        <Eyebrow class="human-eyebrow">03 · The Human Activity</Eyebrow>
        <h2 class="title human-title">You are more than what you ship.</h2>
        <p class="copy" style="line-height: 1.65">In the midst of intense technical sessions, step into a space designed to slow down the pace. Write your thoughts in the Worry Log, pick a reflection card, or join small chats about career shifts, burnout, and staying grounded in a fast-moving industry.</p>
        <p class="human-note">Coming alone is completely fine. Sharing is not mandatory. Take the space you need.</p>
      </div>
      <div class="human-grid">
        <div class="human-card" style="transform: rotate(-1.5deg)">
          <span class="mono human-card-label">Worry Log</span>
          <span>Write down what has been on your mind. Leave it on the wall.</span>
        </div>
        <div class="human-card" style="background: var(--g-yellow); transform: rotate(1.5deg)">
          <span class="mono human-card-label" style="color: var(--ink)">Reflection Card</span>
          <span>Pick one prompt. Keep it, or talk it through.</span>
        </div>
        <img class="photo human-photo" src={PHOTOS.tableWave.src} srcset={srcset(PHOTOS.tableWave)} sizes="(max-width: 1100px) calc(100vw - 48px), 600px" width={PHOTOS.tableWave.width} height={PHOTOS.tableWave.height} alt="A group of attendees smiling and waving together around a table" loading="lazy" decoding="async" />
        <div class="human-chat">
          <span class="dot" style="--dot: var(--g-green); width: 12px; height: 12px"></span>
          <span><strong>Small chats</strong> on career shifts, burnout, and staying grounded.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- VIBE HACKATHON -->
  <section id="hackathon" class="hackathon">
    <div class="container stack" style="--gap: 56px">
      <div class="split" style="--gap: 32px 64px">
        <div class="stack" style="flex: 1 1 520px; --gap: 20px">
          <Eyebrow class="hackathon-eyebrow">04 · Vibe Hackathon</Eyebrow>
          <h2 class="title hackathon-title">Strangers in. Collaborators out.</h2>
        </div>
        <p class="copy hackathon-copy" style="flex: 1 1 420px">No need to come with a team. In the Vibe Hackathon, you will be paired with other attendees to respond to a problem statement, design a solution, and present ideas in a light format. The goal isn’t a perfect product — the goal is starting conversations that continue after the event.</p>
      </div>
      <div class="cluster" style="--gap: 24px">
        <dl class="rows hackathon-rows">
          {hackathon.map((row) => (
            <div><dt class="mono">{row.label}</dt><dd>{row.value}</dd></div>
          ))}
        </dl>
        <img class="photo hackathon-photo" src={PHOTOS.hackathonTables.src} srcset={srcset(PHOTOS.hackathonTables)} sizes="(max-width: 1100px) calc(100vw - 48px), 680px" width={PHOTOS.hackathonTables.width} height={PHOTOS.hackathonTables.height} alt="Attendees building together at shared tables with laptops" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- 2025 RECAP -->
  <section class="section gridbg">
    <div class="container stack recap" style="--gap: 36px">
      <div class="split" style="justify-content: space-between; --gap: 16px">
        <div class="stack" style="--gap: 12px">
          <Eyebrow>DevFest Bandung 2025 · Recap</Eyebrow>
          <h2 class="title recap-title">Last year, the room was full.</h2>
        </div>
        <a class="more-link" href="/sponsor">See the full 2025 recap →</a>
      </div>
      <div class="auto-grid" style="--min: 220px; --gap: 12px">
        {lastYear.map((stat) => (
          <div class="tile tile--white stat">
            <span class="stat-value" style={`color: ${stat.color}`}>{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SPONSOR + CFS -->
  <section class="section section--white">
    <div class="container auto-grid" style="--min: 340px; --gap: 20px">
      <div class="promo" style="background: var(--blue-soft)">
        <Eyebrow class="promo-eyebrow">Partner with us</Eyebrow>
        <h2>Help people learn, connect, and feel at home in tech.</h2>
        <p class="copy-17" style="line-height: 1.6">The partnership at DevFest Bandung is more than just a logo. Bring a product challenge for the Vibe Hackathon, support charging lounges and codelabs, activate booths that help attendees, or partner for The Human Activity. We are looking for brands that want to bring real value to {SITE.capacity} builders in Bandung.</p>
        <div class="promo-action"><a class="btn btn--blue" href={LINKS.sponsorship}>Become a sponsor →</a></div>
      </div>
      <div class="promo" style="background: var(--paper)">
        <Eyebrow>Call for speakers</Eyebrow>
        <h2>Teach what you have learned. Share what makes you human.</h2>
        <div class="rows promo-rows">
          {speakerFormats.map((format) => (
            <div><strong>{format.title}</strong><span>{format.copy}</span></div>
          ))}
        </div>
        <div class="promo-action"><a class="btn btn--dark" href={LINKS.cfs}>Submit a talk →</a></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section gridbg">
    <div class="container faq-band">
      <div class="stack" style="flex: 1 1 300px; min-width: 0">
        <Eyebrow>FAQ</Eyebrow>
        <h2 class="title">Questions, answered.</h2>
        <a class="more-link" href="/faq">Read all FAQs →</a>
      </div>
      <div class="stack" style="flex: 2 1 560px; min-width: 0; --gap: 10px">
        {HOME_FAQS.map((faq, index) => <FaqItem faq={faq} open={index === 0} />)}
      </div>
    </div>
  </section>

  <CtaBand
    title="Come for the tech. Stay for the people."
    subtitle={`${SITE.dateMedium} · ${SITE.time} · ${SITE.venue} · ${SITE.capacity} seats`}
    href={LINKS.register}
    label="Register now →"
  />
</EventLayout>

<style>
  /* Hero */
  .hero { padding: 72px 24px 88px; display: flex; flex-wrap: wrap; gap: 56px; align-items: stretch; }
  .hero-copy { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .hero-title { margin: 0; font-size: clamp(48px, 7vw, 96px); line-height: 0.98; letter-spacing: -2px; font-weight: 700; }
  .hero-theme { margin: 0; display: flex; flex-wrap: wrap; gap: 10px 14px; font-size: clamp(28px, 3.4vw, 44px); font-weight: 700; letter-spacing: -0.5px; line-height: 1.1; }
  .hero-theme-meets { color: var(--muted); font-weight: 400; }
  .hero-actions { margin-top: 8px; }
  .hero-photos { flex: 1 1 420px; min-width: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: minmax(300px, 1fr) 220px; gap: 12px; }
  .hero-photo-main { grid-column: span 2; height: 100%; min-height: 300px; object-position: center 55%; }
  .hero-photo-sub { height: 220px; border-bottom: 6px solid var(--accent); box-sizing: border-box; }

  /* Why */
  .reason { padding: 32px; gap: 12px; }
  .reason h3 { margin-top: 8px; }
  .shape { width: 44px; height: 44px; }
  .shape--square { border-radius: 12px; background: var(--g-blue); }
  .shape--circle { border-radius: 50%; background: var(--g-red); }
  .shape--triangle { width: 0; height: 0; border-left: 24px solid transparent; border-right: 24px solid transparent; border-bottom: 42px solid var(--g-yellow); }

  /* Pillars */
  a.pillar { color: var(--ink); text-decoration: none; transition: border-color 0.15s; }
  a.pillar:hover { border-color: var(--blue); }
  .pillar-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .pillar-number { font-size: 14px; color: var(--muted); }

  /* Rooms */
  .room { border-radius: 24px; overflow: hidden; border: 1px solid var(--room-line); display: flex; flex-direction: column; }
  .room-head { background: var(--room); color: var(--room-on); padding: 24px 28px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .room-head h3 { margin: 0; font-size: 26px; }
  .room-label { font-size: 13px; border: 1px solid currentColor; border-radius: 999px; padding: 4px 10px; white-space: nowrap; }
  .room-body { flex: 1; background: var(--room-soft); padding: 28px; display: flex; flex-direction: column; gap: 18px; }
  .room-audience { margin: 0; font-size: 17px; line-height: 1.55; }
  .room-field { display: flex; flex-direction: column; gap: 4px; }
  .room-field-label { font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--room-ink); }
  .room-format { font-size: 17px; font-weight: 700; }

  /* Human Activity */
  .human { background: var(--cream); border-bottom-color: var(--cream-line); }
  .human-inner { padding-top: 104px; padding-bottom: 104px; display: flex; flex-wrap: wrap; gap: 56px; align-items: center; }
  .human :global(.human-eyebrow) { color: var(--amber-ink); }
  .human-title { font-size: clamp(36px, 4.4vw, 58px); line-height: 1.05; }
  .human-note { margin: 0; font-size: 17px; line-height: 1.6; color: var(--amber-ink); font-style: italic; }
  .human-grid { flex: 1 1 460px; min-width: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .human-card { background: var(--white); border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 10px; font-size: 19px; line-height: 1.4; }
  .human-card-label { font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--amber-ink); }
  .human-photo { grid-column: span 2; height: 280px; object-position: center 35%; }
  .human-chat { grid-column: span 2; background: var(--white); border-radius: 20px; padding: 20px 24px; display: flex; align-items: center; gap: 14px; font-size: 17px; line-height: 1.4; }

  /* Hackathon */
  .hackathon { background: var(--ink); color: var(--white); }
  .hackathon .container { padding-top: 104px; padding-bottom: 104px; }
  .hackathon :global(.hackathon-eyebrow) { color: var(--red-on-dark); }
  .hackathon-title { font-size: clamp(38px, 4.8vw, 64px); line-height: 1.02; letter-spacing: -1.5px; }
  .hackathon-copy { color: var(--line); line-height: 1.65; }
  .hackathon-rows { --rows-line: var(--muted); flex: 1 1 520px; min-width: 0; margin: 0; }
  .hackathon-rows dt { flex: 0 0 160px; font-size: 14px; letter-spacing: 1px; text-transform: uppercase; color: var(--red-on-dark); }
  .hackathon-rows dd { flex: 1 1 260px; margin: 0; font-size: 18px; }
  .hackathon-photo { flex: 1 1 380px; min-width: 0; width: 100%; height: 380px; }

  /* Recap */
  .recap-title { font-size: clamp(30px, 3.4vw, 44px); line-height: 1.1; }
  .more-link { font-weight: 500; font-size: 17px; }
  .stat { gap: 6px; }
  .stat-value { font-size: 48px; font-weight: 700; letter-spacing: -1px; line-height: 1.1; }
  .stat-label { font-size: 16px; color: var(--text-2); }

  /* Sponsor + CFS */
  .promo { border-radius: 28px; padding: 44px; display: flex; flex-direction: column; gap: 20px; }
  .promo h2 { margin: 0; font-size: clamp(30px, 3vw, 40px); line-height: 1.1; letter-spacing: -0.5px; }
  .promo-action { margin-top: auto; padding-top: 8px; }
  .promo :global(.promo-eyebrow) { color: var(--blue-ink); }
  .promo-rows > div { flex-direction: column; gap: 4px; padding: 14px 0; }
  .promo-rows strong { font-size: 17px; }
  .promo-rows span { font-size: 15px; line-height: 1.5; color: var(--text-2); }

  /* FAQ */
  .faq-band { display: flex; flex-wrap: wrap; gap: 40px 64px; }

  @media (max-width: 600px) {
    .hero-photos { grid-template-rows: 220px 140px; }
    .hero-photo-main { min-height: 0; }
    .hero-photo-sub { height: 140px; }
    .hackathon-photo { height: 240px; }
    .promo { padding: 28px; }
    .stat-value { font-size: 38px; }
  }
</style>
