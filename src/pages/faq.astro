---
import EventLayout from "../components/layout/EventLayout.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import FaqItem from "../components/ui/FaqItem.astro";
import { FAQ_GROUPS, SITE } from "../data/site.data";
---

<EventLayout title="FAQ — DevFest Bandung 2026">
  <section class="section gridbg">
    <div class="container faq">
      <div class="stack intro" style="--gap: 20px">
        <Eyebrow color="var(--g-yellow)" strong>FAQ</Eyebrow>
        <h1 class="display faq-title">Questions, answered.</h1>
        <p class="copy-17" style="font-size: 18px; line-height: 1.6">Still curious? Email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.</p>
      </div>

      <div class="stack groups" style="--gap: 36px">
        {FAQ_GROUPS.map((group, groupIndex) => (
          <div class="stack" style="--gap: 10px">
            <h2 class="eyebrow group-title">{group.title}</h2>
            {group.faqs.map((faq, index) => <FaqItem faq={faq} open={groupIndex === 0 && index === 0} />)}
          </div>
        ))}
      </div>
    </div>
  </section>
</EventLayout>

<style>
  .faq { padding: 80px 24px 96px; display: flex; flex-wrap: wrap; gap: 48px 64px; }
  .intro { flex: 1 1 320px; min-width: 0; }
  .faq-title { font-size: clamp(42px, 5vw, 68px); }
  .groups { flex: 2 1 600px; min-width: 0; }
  .group-title { margin-bottom: 6px; font-weight: 500; }
</style>
