---
import EventLayout from "../components/layout/EventLayout.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import { LINKS, SITE } from "../data/site.data";

const routes = [
  {
    tone: "background: var(--blue-soft); color: var(--blue-ink)",
    icon: '<path d="M4 15V7a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v8a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3z"></path><path d="M4 11h16"></path><path d="M8 18l-2 3"></path><path d="M16 18l2 3"></path><circle cx="8.5" cy="14.5" r="0.6"></circle><circle cx="15.5" cy="14.5" r="0.6"></circle>',
    title: "High-speed rail (Whoosh)",
    copy: "From Jakarta Halim to Padalarang, then take the connecting feeder train to Bandung Station. The venue is about 1 km from the station.",
  },
  {
    tone: "background: var(--blue-soft); color: var(--blue-ink)",
    icon: '<rect x="5" y="3" width="14" height="14" rx="3"></rect><path d="M5 10h14"></path><path d="M9 17l-2 4"></path><path d="M15 17l2 4"></path><path d="M9 6h6"></path>',
    title: "Train (Argo Parahyangan)",
    copy: "Regular trains from Jakarta Gambir arrive at Bandung Station (BD), around 1 km from the venue — a short ride or a walk.",
  },
  {
    tone: "background: var(--green-soft); color: var(--green-ink)",
    icon: '<rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M3 11h18"></path><circle cx="7" cy="19" r="1.5"></circle><circle cx="17" cy="19" r="1.5"></circle>',
    title: "Bus & travel shuttle",
    copy: "Shuttle and bus operators run frequently from Jakarta and nearby cities to pools across Bandung. Continue by taxi or ride-hailing to the venue.",
  },
  {
    tone: "background: var(--amber-soft); color: var(--amber-ink)",
    icon: '<path d="M5 16V11l2-5h10l2 5v5"></path><path d="M3 16h18v2H3z"></path><circle cx="7.5" cy="13" r="0.8"></circle><circle cx="16.5" cy="13" r="0.8"></circle>',
    title: "Private car",
    copy: "Take the Cipularang toll road from Jakarta and exit at Pasteur, then head to Jl. Merdeka in the city centre. Hotel parking is available.",
  },
  {
    tone: "background: var(--red-soft); color: var(--red-ink)",
    icon: '<path d="M2 16l20-6-2-3-7 2-5-5-2 1 3 5-5 1.5-2-2-1.5.5z"></path><path d="M3 20h18"></path>',
    title: "By air",
    copy: "Husein Sastranegara Airport (BDO) is about 6 km from the venue. Flying via Kertajati (KJT) or Jakarta (CGK)? Continue by road or rail.",
  },
];

const nearby = [
  { place: "Braga CityWalk", distance: "350 m" },
  { place: "Jl. Braga", distance: "440 m" },
  { place: "Bandung Station", distance: "1.1 km" },
  { place: "Husein Sastranegara Airport", distance: "5.8 km" },
];

const hotels = [
  { name: "Aston Braga Hotel & Residence", address: "Jl. Braga No. 99–101", note: "Next to Braga CityWalk, walking distance to the venue." },
  { name: "Prama Grand Preanger", address: "Jl. Asia Afrika No. 81", note: "Heritage hotel at the south end of Jl. Braga." },
  { name: "Savoy Homann Hotel", address: "Jl. Asia Afrika No. 112", note: "Art-deco landmark near Alun-alun Bandung." },
];
---

<EventLayout title="Venue — DevFest Bandung 2026">
  <!-- HERO -->
  <section class="section gridbg">
    <div class="container hero">
      <div class="stack" style="flex: 1 1 520px; min-width: 0; --gap: 24px">
        <Eyebrow color="var(--g-red)" strong>Venue</Eyebrow>
        <h1 class="display hero-title">See you at éL Hotel Bandung.</h1>
        <p class="lead" style="max-width: 560px">In the heart of the city, a short walk from Jl. Braga and about 1 km from Bandung train station.</p>
        <div class="cluster" style="margin-top: 8px">
          <a class="btn btn--blue hero-btn" href={LINKS.maps}>Open in Google Maps ↗</a>
          <a class="btn btn--outline hero-btn" href={LINKS.register}>Register</a>
        </div>
      </div>

      <div class="details">
        <div class="details-bar"></div>
        <div class="detail" style="border-bottom: 1px solid var(--line-soft)">
          <span class="label">Venue</span>
          <span class="detail-venue">éL Hotel Bandung</span>
        </div>
        <div class="detail">
          <span class="label">Address</span>
          <address>Jl. Merdeka No. 2, Braga, Sumur Bandung,<br />Bandung, West Java 40111</address>
        </div>
        <div class="details-grid">
          <div class="detail" style="border-top: 4px solid var(--g-blue); border-right: 1px solid var(--line-soft)">
            <span class="label">Date</span>
            <span class="detail-value">Saturday,<br />19 December 2026</span>
          </div>
          <div class="detail" style="border-top: 4px solid var(--g-green)">
            <span class="label">Time</span>
            <span class="detail-value">08:00–16:00<br />WIB</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GETTING THERE -->
  <section class="section section--white">
    <div class="container stack" style="--gap: 48px">
      <div class="head">
        <Eyebrow>Getting there</Eyebrow>
        <h2 class="title">Five ways into Bandung.</h2>
      </div>
      <div class="auto-grid" style="--min: 340px; --gap: 14px">
        {routes.map((route) => (
          <article class="route">
            <span class="route-icon" style={route.tone}>
              <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={route.icon} />
            </span>
            <div class="stack" style="--gap: 8px">
              <h3>{route.title}</h3>
              <p class="copy-16" style="line-height: 1.6">{route.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- AROUND THE VENUE -->
  <section class="section gridbg">
    <div class="container around">
      <div class="stack" style="flex: 1 1 340px; min-width: 0; --gap: 28px">
        <div class="stack">
          <Eyebrow color="var(--g-green)">Around the venue</Eyebrow>
          <h2 class="title">Right in the city centre.</h2>
        </div>
        <ul class="distances">
          {nearby.map((item) => <li><span>{item.place}</span><span class="mono distance">{item.distance}</span></li>)}
        </ul>
        <a class="directions" href={LINKS.maps}>Get directions in Google Maps ↗</a>
      </div>
      <div class="map">
        <iframe
          src={LINKS.mapsEmbed}
          title="Map showing éL Hotel Bandung, Jl. Merdeka No. 2, Bandung"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <!-- WHERE TO STAY -->
  <section class="section section--white">
    <div class="container stack" style="--gap: 40px">
      <div class="split" style="justify-content: space-between; --gap: 16px 48px">
        <div class="head">
          <Eyebrow>Where to stay</Eyebrow>
          <h2 class="title">Coming from out of town?</h2>
        </div>
        <p class="copy-17" style="font-size: 18px; line-height: normal">A few options near the venue. Book directly with each hotel.</p>
      </div>
      <div class="auto-grid" style="--min: 260px; --gap: 14px">
        <article class="hotel hotel--venue">
          <span class="mono hotel-tag">The venue</span>
          <h3>éL Hotel Bandung</h3>
          <span class="hotel-address">Jl. Merdeka No. 2, Braga</span>
          <p>Stay where it happens — no commute on event day.</p>
        </article>
        {hotels.map((hotel) => (
          <article class="hotel">
            <span class="mono hotel-tag">Nearby</span>
            <h3>{hotel.name}</h3>
            <span class="hotel-address">{hotel.address}</span>
            <p>{hotel.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Come for the tech. Stay for the people."
    subtitle={`${SITE.dateLong} · ${SITE.time} · ${SITE.capacity} seats`}
    href={LINKS.register}
    label="Register now →"
  />
</EventLayout>

<style>
  .hero { padding: 88px 24px 96px; display: flex; flex-wrap: wrap; gap: 56px; align-items: center; }
  .hero-title { font-size: clamp(46px, 6vw, 84px); line-height: 1; letter-spacing: -2px; }
  .hero-btn { font-size: 17px; }

  .details { flex: 1 1 400px; min-width: 0; max-width: 560px; background: var(--white); border-radius: 20px; overflow: hidden; box-shadow: var(--shadow-card); }
  .details-bar { height: 4px; background: var(--g-red); }
  .details-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .detail { padding: 28px 32px; display: flex; flex-direction: column; gap: 8px; }
  .details-grid .detail { padding: 24px 32px; }
  .detail-venue { font-size: 26px; font-weight: 700; }
  .detail-value { font-size: 20px; font-weight: 700; line-height: 1.3; }
  .details address { font-style: normal; font-size: 18px; line-height: 1.55; }

  .route { background: var(--surface); border: 1px solid var(--line-soft); border-radius: 20px; padding: 28px; display: flex; gap: 20px; }
  .route-icon { flex: none; width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; }
  .route h3 { margin: 0; font-size: 21px; }

  .around { display: flex; flex-wrap: wrap; gap: 40px 56px; align-items: center; }
  .distances { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .distances li { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--line); font-size: 18px; }
  .distance { font-weight: 500; color: var(--blue); }
  .directions { font-weight: 500; font-size: 17px; }

  .map { flex: 1.6 1 520px; min-width: 0; height: 460px; position: relative; overflow: hidden; border-radius: 20px; background: #e9ecef; box-shadow: var(--shadow-card); }
  .map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .hotel { background: var(--surface); border: 1px solid var(--line-soft); border-radius: 20px; padding: 28px; display: flex; flex-direction: column; gap: 10px; }
  .hotel h3 { margin: 0; font-size: 22px; }
  .hotel p { margin: 6px 0 0; font-size: 16px; line-height: 1.55; }
  .hotel-tag { font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); }
  .hotel-address { font-size: 15px; color: var(--text-2); }
  .hotel--venue { background: var(--blue-soft); border: 2px solid var(--blue); }
  .hotel--venue .hotel-tag { color: var(--blue-ink); }

  @media (max-width: 600px) {
    .detail, .details-grid .detail { padding: 22px 20px; }
    .route { padding: 22px; }
    .map { height: 340px; }
  }
</style>
