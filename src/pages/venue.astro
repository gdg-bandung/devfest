---
import EventLayout from "../components/layout/EventLayout.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import { LINKS } from "../data/site.data";

const routes = [
  {
    tone: "bg-blue-soft",
    icon: '<path d="M4 15V8a5 5 0 0 1 5-5h6a5 5 0 0 1 5 5v7a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3z"></path><path d="M4 11h16"></path><path d="M8 21l2-3M16 21l-2-3"></path><circle cx="8.5" cy="14.5" r="0.8" fill="currentColor"></circle><circle cx="15.5" cy="14.5" r="0.8" fill="currentColor"></circle>',
    title: "High-speed rail (Whoosh)",
    copy: "From Jakarta Halim to Padalarang, then take the connecting feeder train to Bandung Station. The venue is about 1 km from the station.",
  },
  {
    tone: "bg-green-soft",
    icon: '<rect x="5" y="3" width="14" height="14" rx="3"></rect><path d="M5 10h14"></path><path d="M9 21l1.5-4M15 21l-1.5-4"></path><circle cx="9" cy="13.5" r="0.8" fill="currentColor"></circle><circle cx="15" cy="13.5" r="0.8" fill="currentColor"></circle>',
    title: "Train (Argo Parahyangan)",
    copy: "Regular trains from Jakarta Gambir arrive at Bandung Station (BD), around 1 km from the venue — a short ride or a walk.",
  },
  {
    tone: "bg-yellow-soft",
    icon: '<rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M3 11h18"></path><path d="M7 21v-4M17 21v-4"></path><circle cx="7.5" cy="14" r="0.8" fill="currentColor"></circle><circle cx="16.5" cy="14" r="0.8" fill="currentColor"></circle>',
    title: "Bus & travel shuttle",
    copy: "Shuttle and bus operators run frequently from Jakarta and nearby cities to pools across Bandung. Continue by taxi or ride-hailing to the venue.",
  },
  {
    tone: "bg-red-soft",
    icon: '<path d="M5 17h14v-5l-2-5H7l-2 5z"></path><path d="M5 12h14"></path><circle cx="8" cy="17" r="2"></circle><circle cx="16" cy="17" r="2"></circle>',
    title: "Private car",
    copy: "Take the Cipularang toll road from Jakarta and exit at Pasteur, then head to Jl. Merdeka in the city centre. Hotel parking is available.",
  },
  {
    tone: "",
    icon: '<path d="M10.5 21l1.5-1.5V15l7.5 3v-2.5L12 10.5V5a1.5 1.5 0 0 0-3 0v5.5L1.5 15.5V18L9 15v4.5L10.5 21z" transform="translate(1.5 0)"></path>',
    title: "By air",
    copy: "Husein Sastranegara Airport (BDO) is about 6 km from the venue. Flying via Kertajati (KJT) or Jakarta (CGK)? Continue by road or rail.",
  },
];

const nearby = [
  { place: "Braga CityWalk", distance: "350 m" },
  { place: "Jl. Braga", distance: "440 m" },
  { place: "Bandung Station", distance: "1.1 km" },
  { place: "Husein Sastranegara Airport", distance: "5.8 km" },
];

const hotels = [
  { name: "Aston Braga Hotel & Residence", address: "Jl. Braga No. 99–101", note: "Next to Braga CityWalk, walking distance to the venue." },
  { name: "Prama Grand Preanger", address: "Jl. Asia Afrika No. 81", note: "Heritage hotel at the south end of Jl. Braga." },
  { name: "Savoy Homann Hotel", address: "Jl. Asia Afrika No. 112", note: "Art-deco landmark near Alun-alun Bandung." },
];
---

<EventLayout title="Venue — DevFest Bandung 2026">
  <!-- HERO -->
  <section class="section gridbg">
    <div class="container hero">
      <div class="stack" style="flex: 1 1 560px; --gap: 24px; justify-content: center">
        <Eyebrow color="var(--red)">Venue</Eyebrow>
        <h1 class="display">See you at<br />éL Hotel Bandung.</h1>
        <p class="lead" style="max-width: 600px">In the heart of the city, a short walk from Jl. Braga and about 1 km from Bandung train station.</p>
        <div class="cluster" style="padding-top: 8px">
          <a class="btn btn--blue btn--lg" href={LINKS.maps}>Open in Google Maps ↗</a>
          <a class="btn" href={LINKS.register}>Register</a>
        </div>
      </div>

      <div class="box shadow-10 details">
        <div class="detail span-all" style="border-top: 6px solid var(--red)">
          <div class="label">VENUE</div>
          <div class="detail-venue">éL Hotel Bandung</div>
        </div>
        <div class="detail span-all">
          <div class="label">ADDRESS</div>
          <address>Jl. Merdeka No. 2, Braga, Sumur Bandung,<br />Bandung, West Java 40111</address>
        </div>
        <div class="detail" style="border-right: 2px solid var(--ink); border-top: 6px solid var(--blue)">
          <div class="label">DATE</div>
          <div class="detail-value">Saturday,<br />19 December 2026</div>
        </div>
        <div class="detail" style="border-top: 6px solid var(--green)">
          <div class="label">TIME</div>
          <div class="detail-value">08.00–16.00<br />WIB</div>
        </div>
      </div>
    </div>
  </section>

  <!-- GETTING THERE -->
  <section class="section section--white">
    <div class="container stack" style="--gap: 48px">
      <div class="head">
        <Eyebrow>Getting there</Eyebrow>
        <h2 class="title">Five ways into Bandung.</h2>
      </div>
      <div class="auto-grid" style="--min: 340px">
        {routes.map((route) => (
          <article class:list={["route", "box", "shadow-8", route.tone]}>
            <span class:list={["route-icon", { "route-icon--paper": !route.tone }]}>
              <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={route.icon} />
            </span>
            <div class="route-body">
              <h3>{route.title}</h3>
              <p>{route.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- MAP -->
  <section class="section">
    <div class="container around">
      <div class="stack" style="flex: 1 1 360px">
        <Eyebrow color="var(--green)">Around the venue</Eyebrow>
        <h2 class="title title--56">Right in the city centre.</h2>
        <ul class="distances">
          {nearby.map((item) => <li><span>{item.place}</span><span class="mono">{item.distance}</span></li>)}
        </ul>
      </div>
      <a href={LINKS.maps} class="map gridbg">
        <span aria-hidden="true" class="road road--h"></span>
        <span aria-hidden="true" class="road road--v"></span>
        <span class="map-pin">
          <svg aria-hidden="true" width="56" height="56" viewBox="0 0 24 24" fill="#ea4335" stroke="#1e1e1e" stroke-width="1.5" stroke-linejoin="round"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="10" r="2.6" fill="#fff"></circle></svg>
          <span class="map-label">éL Hotel Bandung · Open map ↗</span>
        </span>
      </a>
    </div>
  </section>

  <!-- NEARBY HOTELS -->
  <section class="section section--white">
    <div class="container stack" style="--gap: 48px">
      <div class="head">
        <Eyebrow color="var(--yellow)">Where to stay</Eyebrow>
        <h2 class="title">Coming from out of town?</h2>
        <p class="copy">A few options near the venue. Book directly with each hotel.</p>
      </div>
      <div class="auto-grid" style="--min: 280px">
        <article class="hotel hotel--venue">
          <span class="mono hotel-tag">THE VENUE</span>
          <h3>éL Hotel Bandung</h3>
          <p class="hotel-address">Jl. Merdeka No. 2, Braga</p>
          <p>Stay where it happens — no commute on event day.</p>
        </article>
        {hotels.map((hotel) => (
          <article class="hotel shadow-8">
            <span class="mono hotel-tag">NEARBY</span>
            <h3>{hotel.name}</h3>
            <p class="hotel-address">{hotel.address}</p>
            <p>{hotel.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</EventLayout>

<style>
  .hero { padding: 80px 32px 88px; display: flex; flex-wrap: wrap; gap: 48px; align-items: stretch; }

  .details { flex: 1 1 440px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .detail { padding: 28px; display: flex; flex-direction: column; gap: 8px; }
  .detail.span-all { border-bottom: 2px solid var(--ink); }
  .detail-venue { font-size: 26px; font-weight: 700; }
  .detail-value { font-size: 20px; font-weight: 700; }
  .details address { font-style: normal; font-size: 18px; line-height: 1.5; }

  .route { padding: 28px; display: flex; gap: 20px; align-items: flex-start; }
  .route-icon { flex: none; width: 52px; height: 52px; background: #fff; border: 2px solid var(--ink); display: inline-flex; align-items: center; justify-content: center; color: var(--ink); }
  .route-icon--paper { background: var(--paper); }
  .route-body { display: flex; flex-direction: column; gap: 8px; }
  .route h3 { margin: 0; font-size: 22px; font-weight: 700; }
  .route p { margin: 0; font-size: 17px; line-height: 1.6; }

  .around { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .distances { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; border-top: 2px solid var(--ink); }
  .distances li { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 2px solid var(--ink); font-size: 17px; }
  .distances .mono { font-weight: 700; }

  .map { flex: 1 1 560px; min-height: 420px; position: relative; border: 2px solid var(--ink); box-shadow: 10px 10px 0 var(--ink); display: flex; align-items: center; justify-content: center; text-decoration: none; overflow: hidden; }
  .road { position: absolute; background: #fff; }
  .road--h { left: 0; right: 0; top: 46%; height: 22px; border-top: 2px solid #c9c9c9; border-bottom: 2px solid #c9c9c9; }
  .road--v { top: 0; bottom: 0; left: 58%; width: 22px; border-left: 2px solid #c9c9c9; border-right: 2px solid #c9c9c9; }
  .map-pin { position: relative; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .map-label { background: #fff; border: 2px solid var(--ink); box-shadow: 5px 5px 0 var(--ink); padding: 12px 20px; font-size: 17px; font-weight: 700; }

  .hotel { background: var(--paper); border: 2px solid var(--ink); padding: 28px; display: flex; flex-direction: column; gap: 10px; }
  .hotel h3 { margin: 0; font-size: 22px; font-weight: 700; }
  .hotel p { margin: 0; font-size: 16px; line-height: 1.6; }
  .hotel .hotel-address { color: var(--muted); }
  .hotel-tag { align-self: flex-start; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; background: #fff; border: 2px solid var(--ink); padding: 2px 8px; }
  .hotel--venue { background: var(--ink); color: #fff; box-shadow: 8px 8px 0 var(--red); }
  .hotel--venue .hotel-address { color: var(--on-dark); }
  .hotel--venue .hotel-tag { background: var(--red); color: #fff; border: 0; padding: 4px 8px; }
</style>
