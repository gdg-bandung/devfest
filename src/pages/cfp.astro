---
import EventLayout from "../components/layout/EventLayout.astro";
---

<EventLayout title="Call for Papers — DevFest 2026 Bandung"
  ><section class="page-hero">
    <div class="wrap">
      <div class="eyebrow mono">Call for papers</div><h1>
        Bring your best<br /><span class="gradient">idea to Bandung.</span>
      </h1><p>
        We are looking for useful stories, hard-won lessons, and practical
        knowledge that helps the developer community move forward.
      </p><div class="notice">
        <b>CFP opens soon.</b> Join the waiting list and be first to receive the submission
        announcement.
      </div><button
        class="button primary"
        style="margin-top:22px"
        data-open-modal>Get CFP updates →</button>
    </div>
  </section><section class="section alt">
    <div class="wrap">
      <div class="eyebrow mono">What we want to hear</div><div class="grid-3">
        <article class="card">
          <div class="icon blue">☁</div><h3>Build for scale</h3><p>
            Cloud, infrastructure, reliability, developer tooling, and lessons
            from production.
          </p>
        </article><article class="card">
          <div class="icon red">✦</div><h3>Applied intelligence</h3><p>
            AI that works in practice, data, responsible technology, and real
            product impact.
          </p>
        </article><article class="card">
          <div class="icon yellow">⌁</div><h3>People & products</h3><p>
            Design, careers, inclusion, leadership, and communities that make
            technology better.
          </p>
        </article>
      </div>
    </div>
  </section><section class="section">
    <div class="wrap two-col">
      <div>
        <div class="eyebrow mono">Every voice matters</div><h2
          class="section-title"
        >
          First-time speakers are welcome.
        </h2><p class="section-copy">
          Great talks start with a perspective worth sharing—not a long speaker
          résumé. We encourage new voices, practical demos, and stories that
          help the room learn together.
        </p>
      </div><div class="card">
        <div class="mono" style="color:#4285f4">Formats to be announced</div><h3
        >
          Talks, panels & lightning ideas
        </h3><p>
          Submission format, review timeline, and speaker support will be
          published when CFP opens.
        </p>
      </div>
    </div>
  </section></EventLayout
>
