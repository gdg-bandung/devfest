---
import EventLayout from "../components/layout/EventLayout.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import { IMAGES, LINKS } from "../data/site.data";

const tracks = [
  {
    number: "TRACK 01",
    tone: "bg-blue-soft",
    title: "Builder track",
    copy: "Practical stories about AI-assisted apps, prototypes, products and the Google ecosystem.",
    fits: ["From problem to working prototype with Gemini", "Workflows you automated and what changed", "Building as a PM, designer or marketer"],
  },
  {
    number: "TRACK 02",
    tone: "bg-red-soft",
    title: "Developer track",
    copy: "Lessons about agents, development, deployment, governance, security and production readiness.",
    fits: ["Designing and orchestrating multi-agent systems", "Securing and governing agents in production", "Scaling on Google Cloud, Firebase or Android"],
  },
];

const criteria = [
  { number: "01", badge: "background: var(--blue)", title: "Practical", copy: "Built on something you actually shipped, ran or broke." },
  { number: "02", badge: "background: var(--red); color: #fff", title: "Clear", copy: "One main idea people can take home and try." },
  { number: "03", badge: "background: var(--yellow)", title: "On theme", copy: "Connects to build, secure or scale in the agentic era." },
];
---

<EventLayout title="Call for Speakers — DevFest Bandung 2026">
  <!-- HERO -->
  <section class="section gridbg">
    <div class="container hero">
      <div class="stack" style="flex: 1 1 600px; --gap: 24px">
        <Eyebrow color="var(--green)">Call for speakers · Open</Eyebrow>
        <h1 class="display">Speak to the<br />whole room.</h1>
        <p class="lead" style="max-width: 620px">Share a practical story, a hard-won technical lesson, or a clear idea that helps developers and builders work in the agentic era.</p>
        <div class="cluster" style="padding-top: 8px">
          <a class="btn btn--green btn--lg" href={LINKS.cfp}>Submit a proposal →</a>
        </div>
      </div>
      <figure class="box shadow-10 hero-photo">
        <img class="photo" src={IMAGES.keynoteStage} alt="Speaker presenting on the main stage at DevFest Bandung 2025" />
        <figcaption class="mono">27 SPEAKERS &amp; PANELISTS IN 2025</figcaption>
      </figure>
    </div>
  </section>

  <!-- TRACKS -->
  <section id="tracks" class="section section--white">
    <div class="container stack" style="--gap: 48px">
      <div class="head">
        <Eyebrow>Two tracks</Eyebrow>
        <h2 class="title">Where does your talk fit?</h2>
      </div>
      <div class="auto-grid" style="--min: 340px; --gap: 32px">
        {tracks.map((track) => (
          <article class:list={["track", "shadow-10", track.tone]}>
            <span class="mono track-number">{track.number}</span>
            <h3>{track.title}</h3>
            <p>{track.copy}</p>
            <div class="mono track-fits">GOOD FITS</div>
            <ul class="arrow-list">
              {track.fits.map((fit) => <li><span aria-hidden="true">→</span>{fit}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHO -->
  <section class="section">
    <div class="container who">
      <div class="stack" style="flex: 1 1 420px">
        <Eyebrow color="var(--red)">Who should apply</Eyebrow>
        <h2 class="title title--56">Your perspective matters more than your title.</h2>
        <p class="copy">We welcome first-time speakers, experienced practitioners, builders and community voices. What counts is what the audience can learn and apply.</p>
      </div>
      <div class="stack" style="flex: 1 1 480px; --gap: 16px">
        {criteria.map((item) => (
          <div class="box criterion">
            <span class="mono criterion-badge" style={item.badge}>{item.number}</span>
            <div>
              <div class="criterion-title">{item.title}</div>
              <div class="criterion-copy">{item.copy}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--green">
    <div class="container cta">
      <h2 class="title title--56">Got a story worth the stage?</h2>
      <a class="btn btn--dark btn--lg" href={LINKS.cfp} data-shadow style="--btn-shadow: var(--green)">Submit a proposal →</a>
    </div>
  </section>
</EventLayout>

<style>
  .hero { padding: 80px 32px 88px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .hero-photo { flex: 1 1 420px; margin: 0; position: relative; }
  .hero-photo img { height: 340px; }
  .hero-photo figcaption { position: absolute; left: 16px; bottom: 16px; background: var(--sunny); border: 2px solid var(--ink); padding: 6px 10px; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; }

  .track { border: 2px solid var(--ink); padding: 40px; display: flex; flex-direction: column; gap: 18px; }
  .track-number { font-size: 13px; font-weight: 700; letter-spacing: 0.1em; }
  .track h3 { margin: 0; font-size: 40px; line-height: 1; letter-spacing: -0.03em; font-weight: 700; }
  .track p { margin: 0; font-size: 18px; line-height: 1.6; }
  .track-fits { font-size: 12px; font-weight: 700; letter-spacing: 0.1em; padding-top: 8px; }

  .who { display: flex; flex-wrap: wrap; gap: 48px; }
  .criterion { padding: 24px; display: flex; gap: 20px; align-items: flex-start; }
  .criterion-badge { font-size: 14px; font-weight: 700; border: 2px solid var(--ink); padding: 4px 8px; }
  .criterion-title { font-weight: 700; font-size: 20px; }
  .criterion-copy { font-size: 17px; color: var(--muted); padding-top: 4px; }

  .cta { padding: 80px 32px; display: flex; flex-wrap: wrap; gap: 32px; align-items: center; justify-content: space-between; }
  .cta .title { flex: 1 1 560px; }

  @media (max-width: 600px) {
    .track h3 { font-size: 30px; }
  }
</style>
